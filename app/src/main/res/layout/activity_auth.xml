<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:id="@+id/imgLogoAuth"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_light"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAuthSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Buat akun untuk mulai memakai"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/inputUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username"
            android:textColor="@color/text_light"
            android:textColorHint="#888888"
            android:inputType="text"
            android:maxLines="1"
            android:padding="14dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/inputPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:textColor="@color/text_light"
            android:textColorHint="#888888"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="14dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/inputPasswordConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ulangi Password"
            android:textColor="@color/text_light"
            android:textColorHint="#888888"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="14dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btnSubmitAuth"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/text_light"
            android:textStyle="bold"
            android:text="DAFTAR &amp; LANJUTKAN" />

        <TextView
            android:id="@+id/txtAuthSwitchMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sudah punya akun? Masuk"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Credit by Gunz"
            android:textColor="#555555"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
