<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header: logo animasi + nama app -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgLogoMain"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textColor="@color/text_light"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Baris tombol bulat berikon: Dashboard, Profil, Pesan, Matikan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="4dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/btnDashboard" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/shape_overlay_button" android:gravity="center" android:text="📊" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Dashboard" android:textColor="#AAAAAA" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/btnProfil" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/shape_overlay_button" android:gravity="center" android:text="👤" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Profil" android:textColor="#AAAAAA" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/btnPesan" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/shape_overlay_button" android:gravity="center" android:text="✉️" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pesan" android:textColor="#AAAAAA" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/btnMatikanMobi" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/shape_pull_tab" android:gravity="center" android:text="⏻" android:textColor="#E57373" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Matikan" android:textColor="#AAAAAA" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Area tengah: tombol + besar untuk menambahkan/memilih game -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btnTambahApp"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/text_light"
                android:textSize="36sp"
                android:textStyle="bold"
                android:text="+"
                app:cornerRadius="45dp"
                style="@style/Widget.MaterialComponents.Button" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pilih Aplikasi / Game"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Daftar game yang sudah pernah dipetakan (favorit) -->
    <TextView
        android:id="@+id/txtFavoritLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Game Tersimpan"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/scrollFavorit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/rowFavorit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </HorizontalScrollView>

    <!-- Baris tombol bulat berikon: izin Overlay & Aksesibilitas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/btnOverlayPermission" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/shape_overlay_button" android:gravity="center" android:text="🪟" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Izin Overlay" android:textColor="#AAAAAA" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/btnAccessibility" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/shape_overlay_button" android:gravity="center" android:text="♿" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Aksesibilitas" android:textColor="#AAAAAA" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:text="@string/credit_text"
        android:textColor="#444444"
        android:textSize="10sp" />

</LinearLayout>
