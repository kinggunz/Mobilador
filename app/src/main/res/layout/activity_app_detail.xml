<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Latar belakang: icon aplikasi diperbesar & digelapkan, mengisi penuh layar -->
    <ImageView
        android:id="@+id/imgAppBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.35" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3121212" />

    <ImageButton
        android:id="@+id/btnBackDetail"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="14dp"
        android:background="@drawable/shape_overlay_button"
        android:contentDescription="Kembali"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/imgAppIconBig"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_icon_big" />

        <TextView
            android:id="@+id/txtAppLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/text_light"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMappingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="26dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="24dp">
                <TextView
                    android:id="@+id/btnAturMappingDetail"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_icon_big"
                    android:gravity="center"
                    android:text="⚙️"
                    android:textSize="26sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_atur_mapping"
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <TextView
                    android:id="@+id/btnMulaiDetail"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_icon_big"
                    android:backgroundTint="@color/primary"
                    android:gravity="center"
                    android:text="▶️"
                    android:textSize="28sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_mulai"
                    android:textColor="@color/text_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
