<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Latar belakang: icon aplikasi diperbesar & digelapkan, mengisi penuh layar -->
    <ImageView
        android:id="@+id/imgAppBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.35" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3121212" />

    <ImageButton
        android:id="@+id/btnBackDetail"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="14dp"
        android:background="@drawable/shape_overlay_button"
        android:contentDescription="Kembali"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/imgAppIconBig"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_icon_big" />

        <TextView
            android:id="@+id/txtAppLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/text_light"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMappingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAturMappingDetail"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_atur_mapping" />

        <Button
            android:id="@+id/btnMulaiDetail"
            android:layout_width="220dp"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/text_light"
            android:textStyle="bold"
            android:text="@string/btn_mulai" />
    </LinearLayout>

</FrameLayout>
